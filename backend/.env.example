# AI Virtual Staging Studio — backend environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# NOTE: If no API key is provided, the backend automatically runs in MOCK mode:
# it returns the original image with a light "PREVIEW (mock)" watermark so the
# app runs and tests pass with zero keys.

# --- Google Gemini (nano-banana image editing) -----------------------------
# Provide EITHER GEMINI_API_KEY or GOOGLE_API_KEY. If both are set,
# GEMINI_API_KEY takes precedence.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Model overrides (optional). Defaults shown below are used when unset.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173

# --- Server -----------------------------------------------------------------
# Host/port are consumed by uvicorn when launched via `python -m app.main`.
HOST=0.0.0.0
PORT=8000
