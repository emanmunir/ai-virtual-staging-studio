# ---------------------------------------------------------------------------
# Environment / secrets
# NEVER commit a real .env — every variant is ignored below.
# Only *.env.example (tracked) should contain placeholder values.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Repo-specific outputs
# ---------------------------------------------------------------------------
backend/outputs/
backend/data/*.png
backend/data/*.jpg
backend/data/*.jpeg

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
